{
  "name": "lalapiceria/backend",
  "description": "Backend PHP para el Sistema de Gestión de La Lapicería",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "dompdf/dompdf": "^3.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests"
  }
}
